// cortex.onurkenar.com — WP-OnKe yayını. Statik dosyalar + ana sayfayı önceden sıkıştırılmış sunan küçük Worker (src/index.js).
// Yayınlamak: bu klasörde `npm run yayinla` (yayinla.sh HTML'i public/index.html'e kopyalar, .br / .gz üretir, ETag'i yazar ve deploy eder).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cortex",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/index.html"]
  },
  "routes": [
    { "pattern": "cortex.onurkenar.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
